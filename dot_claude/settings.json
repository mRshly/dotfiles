{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch"
    ],
    "ask": ["Bash(npm install *)"],
    "deny": [
      "Agent(model:opus)",
      "Agent(model:fable)",
      "Bash(git push -f *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout .)",
      "Bash(git clean -f *)",
      "Bash(git add .)",
      "Bash(git add -A)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R *)",
      "Bash(chown -R *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(kill -9 *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(curl *|*sh)",
      "Bash(wget *|*sh)",
      "Bash(open *)",
      "Bash(osascript *)",
      "Bash(defaults write *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(npm publish *)",
      "Bash(yarn publish *)",
      "Bash(pnpm publish *)",
      "Bash(*deploy*)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(docker push *)",
      "Bash(podman push *)",
      "Bash(aws * --no-cli-pager)",
      "Bash(gcloud * --quiet)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_schedule_message"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5",
  "statusLine": {
    "type": "command",
    "command": "bash -c 'input=$(cat); printf %s \"$input\" | python3 \"$HOME/.claude/runcat-statusline.py\" >/dev/null 2>&1; printf %s \"$input\" | bash \"$HOME/.claude/statusline-command.sh\"'"
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": false,
    "feature-dev@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "language": "Japanese",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
